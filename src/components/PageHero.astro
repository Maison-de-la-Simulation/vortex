---
import { sitePath, workshop } from '../data/workshop'

interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---
<section class="page-hero frame-width" aria-labelledby="page-title">
  <img class="page-hero-image" src={sitePath('images/vortex-density.webp')} alt="" width="940" height="790" />
  <div class="page-hero-content">
    <p class="eyebrow"><time datetime={workshop.dateISO}>{workshop.date}</time> / Saclay</p>
    <h1 id="page-title">{title}</h1>
    {subtitle && <p class="page-hero-subtitle">{subtitle}</p>}
  </div>
</section>
